#!/usr/bin/env bash
set -euo pipefail

TARGET="${1:-}"
AUTHORING_DB="${DEVELOPMENT_DATABASE:-rdjessee_blog_authoring}"
PROJECT="rdjessee-blog-preview"
AWS_PROFILE="${AWS_PROFILE:-rdjessee-static-setup}"

if [[ "$AUTHORING_DB" != "rdjessee_blog_authoring" ]]; then
  echo "Refusing to publish from ${AUTHORING_DB}; set DEVELOPMENT_DATABASE=rdjessee_blog_authoring." >&2
  exit 2
fi

case "$TARGET" in
  preview) BRANCH="codex/static-site-conversion" ;;
  production) BRANCH="master" ;;
  *)
    echo "Usage: bin/publish-static-site preview|production" >&2
    exit 2
    ;;
esac

if [[ "$TARGET" == "preview" ]]; then
  # Keep preview and local review traffic out of the production GA4 reports.
  export GA4_MEASUREMENT_ID=""
else
  # Public Measurement ID for the RDJ Blog - GA4 web stream.
  export GA4_MEASUREMENT_ID="${GA4_MEASUREMENT_ID:-G-X591M6Y07B}"
fi

DEVELOPMENT_DATABASE="$AUTHORING_DB" docker compose run --rm web bundle exec rails static_archive:export
DEVELOPMENT_DATABASE="$AUTHORING_DB" python3 script/run_with_aws_profile.py "$AWS_PROFILE" \
  docker compose run --rm \
    -e AWS_ACCESS_KEY_ID -e AWS_SECRET_ACCESS_KEY -e AWS_SESSION_TOKEN -e AWS_REGION -e S3_BUCKET \
    web bundle exec rails static_archive:publish_media
DEVELOPMENT_DATABASE="$AUTHORING_DB" docker compose run --rm web bundle exec rails static_archive:verify_media_published
npm run site:build
npx wrangler pages deploy dist/static-site --project-name "$PROJECT" --branch "$BRANCH"
