<section id="picture_new">
  <div class="container-fluid">
    <div class="row">
      <div class="col-lg-12 text-center">
        <h4>Upload A New Picture</h4>
        <hr class="pageLine">
      </div>
    </div>
    <div class="row">
      <div class="col-lg-12 wow fadeIn">
        <%= form_for(@picture) do |f| %>
          <%= render 'shared/error_messages', object: f.object %>
          <%= f.hidden_field :user_id, value: current_user.id %>
          <div>
            <%= f.label :caption %>
            <%= plain_html_editor f, :caption, class: 'form-control' %>
          </div>
          <div class="picture">
            <%= f.label "Upload picture" %>
            <%= f.file_field :picture, accept: "image/jpeg,image/png,image/gif,image/webp" %>
          </div>
          <br>
          <div class="text-center">
            <%= f.submit "Upload Picture", class: "btn btn-default btn-lg buttonDropShadow" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</section>
 
