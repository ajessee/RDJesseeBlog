<section id="blog_full">
  <!-- Flash Section -->
  <% if !flash.empty? %> <%= render 'shared/flash' %> <% end %>
  <div class="container-fluid text-center">
    <div>
      <p>
        <%= link_to 'Most Recent', "/stories/sort?sort=alphabetical", class: "btn btn-primary", role: "button" %>
      </p>
      <button type="button" class="btn btn-primary active">Primary</button>
    </div>
    <%= will_paginate @stories %>
    <div class="row">
      <% @stories.each do |story| %>
        <div class="col-sm-6 col-md-4">
          <div class="thumbnail">
            <% if story.picture.attached? %> <%= image_tag story.picture, alt: "Thumbnail", class: "img-responsive center-picture" %> <% end %>
            <div class="caption">
              <h3><%= story_html(story.title) %></h3>
              <p>
                <%= story_html(truncate(story.content, length: 125, omission: '...(click to continue reading)', escape: false)) %>
              </p>
              <p>
                <a href=" <%= story_path(story.id) %> " class="btn btn-primary" role="button">Read</a>
              </p>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>
